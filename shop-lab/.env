# ---- shop-lab environment ----
# Compose project name (namespaces containers/network/volumes)
COMPOSE_PROJECT_NAME=shop-lab

# ---- Kafka (KRaft, single broker) ----
# Fixed base64 cluster id used to format the KRaft metadata log.
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
# Host port for external clients (host 9092 is already in use by another stack, so we use 19092).
KAFKA_HOST_PORT=19092
# Bootstrap addresses.
KAFKA_INTERNAL_BOOTSTRAP=kafka:29092
KAFKA_EXTERNAL_BOOTSTRAP=localhost:19092

# ---- Topic ----
TOPIC_ORDER_CREATED=order.created.v1
TOPIC_PARTITIONS=3
TOPIC_REPLICATION_FACTOR=1

# ---- kafka-ui ----
KAFKA_UI_PORT=8085

# ---- application services ----
ORDER_SERVICE_PORT=18080
LOGISTIC_SERVICE_PORT=18081
# Consumer processing cap (messages/second) per logistic-service instance.
RATE_LIMIT_PERMITS=50

# ---- Observability (used from Phase 3+; declared here for a single source of truth) ----
OTLP_GRPC_ENDPOINT=http://otel-collector:4317
PROMETHEUS_PORT=9091
GRAFANA_PORT=3001
TEMPO_HTTP_PORT=3200
