          <ResponseAssertion guiclass="AssertionGui" testclass="ResponseAssertion" testname="Order accepted" enabled="true">
            <collectionProp name="Asserion.test_strings">
              <stringProp name="49586">202</stringProp>
            </collectionProp>
            <stringProp name="Assertion.custom_message"></stringProp>
            <stringProp name="Assertion.test_field">Assertion.response_code</stringProp>
            <boolProp name="Assertion.assume_success">false</boolProp>
            <intProp name="Assertion.test_type">8</intProp>
          </ResponseAssertion>
          <hashTree/>
        </hashTree>
        <JSR223Timer guiclass="TestBeanGUI" testclass="JSR223Timer" testname="Global request rate (throughput timer)" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="script"><![CDATA[
import java.util.concurrent.TimeUnit

// A single next-slot value in JMeter properties coordinates every thread, so
// requestsPerMinute is a global target rather than a per-thread target.
def perMinute = new BigDecimal(props.get('requestsPerMinute', '3600'))
if (perMinute.signum() <= 0) {
    throw new IllegalArgumentException('requestsPerMinute must be greater than zero')
}
long intervalNanos = new BigDecimal('60000000000').divide(perMinute, 0, java.math.RoundingMode.HALF_UP).longValueExact()
long waitNanos
synchronized (props) {
    long now = System.nanoTime()
    long next = Long.parseLong(props.get('shop-lab.next-request-nanos', Long.toString(now)))
    long slot = Math.max(now, next)
    props.put('shop-lab.next-request-nanos', Long.toString(slot + intervalNanos))
    waitNanos = slot - now
}
if (waitNanos > 0) {
    TimeUnit.NANOSECONDS.sleep(waitNanos)
}
]]></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="parameters"></stringProp>
          <boolProp name="cacheKey">true</boolProp>
        </JSR223Timer>
        <hashTree/>
        <ResultCollector guiclass="SummaryReport" testclass="ResultCollector" testname="Summary Report" enabled="true">
          <boolProp name="ResultCollector.error_logging">false</boolProp>
